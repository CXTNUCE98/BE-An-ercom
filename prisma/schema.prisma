generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  MOMO
}

enum CouponType {
  PERCENT
  FIXED
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  phone     String?
  address   String?
  avatar    String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  reviews   Review[]
  wishlist  Wishlist[]
  addresses Address[]

  @@map("users")
}

// ─── Product ──────────────────────────────────────────────────────────────────

model ProductCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("product_categories")
}

model Product {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  brand        String
  price        Int
  salePrice    Int?
  description  String?
  images       String[]      @default([])
  specs        Json          @default("[]")
  tags         String[]      @default([])
  rating       Float         @default(0)
  reviewCount  Int           @default(0)
  stock        Int           @default(0)
  status       ProductStatus @default(ACTIVE)
  isNew        Boolean       @default(false)
  isBestSeller Boolean       @default(false)
  isLuxury     Boolean       @default(false)
  videoUrl     String?
  videoPoster  String?
  highlights   String[]      @default([])
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  orderItems   OrderItem[]
  reviews      Review[]
  wishlist     Wishlist[]
  comboItems   ComboItem[]

  @@index([deletedAt])
  @@index([status])
  @@index([categoryId])
  @@index([brand])
  @@index([price])
  @@index([createdAt])
  @@map("products")
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(uuid())
  userId          String
  status          OrderStatus   @default(PENDING)
  totalPrice      Int
  shippingAddress String
  phone           String
  note            String?
  paymentMethod   PaymentMethod @default(COD)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Int

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([isApproved])
  @@map("reviews")
}

model Coupon {
  id           String     @id @default(uuid())
  code         String     @unique
  type         CouponType @default(PERCENT)
  value        Int
  minOrder     Int        @default(0)
  maxDiscount  Int?
  usageLimit   Int?
  usedCount    Int        @default(0)
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("coupons")
}

// ─── Wishlist ───────────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

// ─── Address book ─────────────────────────────────────────────────────────────

model Address {
  id        String   @id @default(uuid())
  userId    String
  fullName  String
  phone     String
  line      String
  ward      String?
  district  String?
  province  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─── Combo / Bundle ───────────────────────────────────────────────────────────

model Combo {
  id           String      @id @default(uuid())
  slug         String      @unique
  name         String
  description  String?
  image        String?
  comboPrice   Int
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items        ComboItem[]

  @@map("combos")
}

model ComboItem {
  id        String  @id @default(uuid())
  comboId   String
  productId String
  quantity  Int     @default(1)

  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([comboId])
  @@map("combo_items")
}

// ─── Password reset ─────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}
